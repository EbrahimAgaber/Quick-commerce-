# Gemini AI API Configuration (Server-Side only)
GEMINI_API_KEY="your-gemini-api-key"

# Application URL & CORS Configuration
APP_URL="https://your-domain.vercel.app"
ALLOWED_ORIGIN="https://your-domain.vercel.app"

# Firebase Client Configuration (Vite environment variables)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="(default)"

# Set to "true" to allow local demo storefront preview without live Firebase connection
VITE_DEMO_MODE="false"

# Firebase Admin SDK Credentials (Server-Side only in Vercel Serverless Functions)
# Used for server-side order transactions, token verification, and stock decrement
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# Store the private key with newlines preserved or replace newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional App Check / reCAPTCHA Enterprise secret key for rate limiting and bot protection
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Moyasar Payments Gateway (Optional merchant defaults or platform webhook secret)
MOYASAR_API_URL="https://api.moyasar.com/v1"
