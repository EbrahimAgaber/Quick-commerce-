{
  "entities": {
    "merchant": {
      "title": "Merchant",
      "description": "Merchant user profile and credentials",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Merchant UID"
        },
        "name": {
          "type": "string",
          "description": "Display name of merchant"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Merchant email address"
        },
        "avatarUrl": {
          "type": "string",
          "description": "Merchant avatar profile photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "name", "email"]
    },
    "store": {
      "title": "Store",
      "description": "Public merchant store catalog, settings, and policies (never stores customer orders)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique store ID"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner merchant UID"
        },
        "slug": {
          "type": "string",
          "description": "Store URL identifier"
        },
        "storeName": {
          "type": "string",
          "description": "Store display name"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        },
        "settings": {
          "type": "object",
          "description": "Store settings, theme, and branding"
        },
        "products": {
          "type": "array",
          "description": "Product catalog"
        },
        "policies": {
          "type": "array",
          "description": "Store policies"
        }
      },
      "required": ["id", "ownerId", "slug", "storeName"]
    },
    "order": {
      "title": "Order",
      "description": "Customer order record isolated inside /stores/{storeId}/orders/{orderId}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "city": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "landmarkNotes": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "itemsSummary": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" },
        "trackingNotes": { "type": "string" }
      },
      "required": [
        "id",
        "timestamp",
        "customerName",
        "customerPhone",
        "city",
        "deliveryAddress",
        "paymentMethod",
        "items",
        "subtotal",
        "shippingFee",
        "grandTotal",
        "status"
      ]
    }
  },
  "firestore": {
    "/merchants/{merchantId}": {
      "schema": "merchant",
      "description": "Collection of merchant profiles"
    },
    "/stores/{storeId}": {
      "schema": "store",
      "description": "Public store catalogs created by merchants"
    },
    "/stores/{storeId}/orders/{orderId}": {
      "schema": "order",
      "description": "Isolated customer orders per store"
    }
  }
}
