rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isStoreOwner(storeId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/stores/$(storeId)) &&
             get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    function isValidMerchant(data) {
      return data.keys().hasAll(['id', 'name', 'email']) &&
             data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidStore(data) {
      return data.keys().hasAll(['id', 'ownerId', 'slug', 'storeName']) &&
             !('orders' in data) &&
             data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 128 &&
             data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 200;
    }

    function isReservedSlug(slug) {
      return slug in [
        'admin', 'api', 'app', 'login', 'register', 'auth', 's', 'aurora', 'storelink',
        'store', 'dashboard', 'checkout', 'orders', 'cart', 'static', 'assets', 'tracking',
        'null', 'undefined', 'privacy', 'terms', 'help', 'settings', 'webhook', 'webhooks'
      ];
    }

    // Merchants profile collection (Private to the authenticated merchant)
    match /merchants/{merchantId} {
      allow get: if isSignedIn() && isValidId(merchantId) && request.auth.uid == merchantId;
      allow create: if isSignedIn() && isValidId(merchantId) && request.auth.uid == merchantId && isValidMerchant(request.resource.data);
      allow update: if isSignedIn() && isValidId(merchantId) && request.auth.uid == merchantId && isValidMerchant(request.resource.data);
      allow delete: if false;
    }

    // Slug Registry (Ensures globally unique, unhijackable store URLs)
    // Only verified store owner can claim a slug for a store they own.
    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(slug) &&
                    !isReservedSlug(slug) &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.storeId is string &&
                    isStoreOwner(request.resource.data.storeId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Tracking Projection: server-managed projection. Direct public read/write disabled.
    // Tracking is served exclusively through serverless endpoint /api/tracking.ts.
    match /tracking/{orderId} {
      allow read, write: if false;
    }

    // Stores collection (Public storefront info, strict owner-only write, no arbitrary list)
    match /stores/{storeId} {
      // Direct store get is public; listing is allowed only for the store's authenticated owner
      allow get: if true;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(storeId) && storeId != 'store_aurora_01' && isValidStore(request.resource.data);
      allow update: if isSignedIn() && isValidId(storeId) && storeId != 'store_aurora_01' && resource.data.ownerId == request.auth.uid && isValidStore(request.resource.data);
      allow delete: if isSignedIn() && isValidId(storeId) && storeId != 'store_aurora_01' && resource.data.ownerId == request.auth.uid;

      // Private Merchant Config Subcollection (Promo codes, bank details, webhook keys, emails)
      match /private/{docId} {
        allow read, write: if isStoreOwner(storeId);
      }

      // Products Subcollection
      match /products/{productId} {
        allow get, list: if true;
        allow create, update, delete: if isStoreOwner(storeId);
      }

      // Orders Subcollection:
      // Orders are server-write-only (created and processed by Admin SDK via /api/createOrder and /api/updateOrderStatus).
      // Clients get create: false and unauthenticated updates are blocked.
      // Verified store owner can read, list, and update whitelisted operational metadata only.
      match /orders/{orderId} {
        allow create: if false;
        allow get, list: if isStoreOwner(storeId);
        allow update: if isStoreOwner(storeId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'trackingNotes', 'courierName', 'courierPhone',
                           'trackingNumber', 'trackingUrl', 'driverCashCollected',
                           'driverDeliveredAt', 'driverSettled', 'driverSettledAt',
                           'returnEligibleUntil', 'returnRequestedAt', 'returnReason',
                           'returnNotes', 'returnStatus', 'returnItems', 'returnedAt',
                           'refundedAmount', 'refundReason', 'refundedAt', 'updatedAt'
                         ]);
        allow delete: if false;
      }
    }

    // Delivery Captains Collection (Dynamic registration, owner activation, delivery stats)
    function isPlatformOwner() {
      return isSignedIn() && request.auth.token.role == 'platform_owner';
    }

    match /captains/{captainId} {
      allow get: if isPlatformOwner() || (isSignedIn() && request.auth.uid == captainId);
      allow list: if isPlatformOwner();
      allow create: if isSignedIn() && isValidId(captainId) &&
                    request.resource.data.keys().hasAll(['id', 'name', 'phone', 'city', 'status']) &&
                    request.resource.data.id == captainId &&
                    request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                    request.resource.data.phone is string && request.resource.data.phone.size() >= 8 &&
                    request.resource.data.status == 'pending_activation';
      allow update: if isPlatformOwner() ||
                    (isSignedIn() && request.auth.uid == captainId && isValidId(captainId) &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vehicleType', 'city', 'lastActiveAt']));
      allow delete: if false;
    }
  }
}
